{
  "name": "@rimelabs/api",
  "version": "@VERSION@",
  "description": "Generated protocol definitions for Rime text-to-speech and speech-to-text",
  "type": "module",
  "sideEffects": false,
  "repository": {"type": "git", "url": "git+https://github.com/rimelabs/rime-api.git"},
  "files": ["esm", "commonjs", "schema", "SOURCE.json", "README.md", "LICENSE", "NOTICE", "PROTOBUF_LICENSE"],
  "main": "./commonjs/index.js",
  "module": "./esm/index.js",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "require": {
        "types": "./commonjs/index.d.ts",
        "default": "./commonjs/index.js"
      }
    },
    "./grpc": {
      "import": {
        "types": "./esm/grpc.d.ts",
        "default": "./esm/grpc.js"
      },
      "require": {
        "types": "./commonjs/grpc.d.ts",
        "default": "./commonjs/grpc.js"
      }
    }
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0"
  },
  "peerDependencies": {
    "@grpc/grpc-js": "^1.14.0"
  },
  "peerDependenciesMeta": {
    "@grpc/grpc-js": {"optional": true}
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "license": "Apache-2.0"
}
