diff --git a/.github/workflows/public-api-compatibility.yaml b/.github/workflows/public-api-compatibility.yaml
new file mode 100644
--- /dev/null
+++ b/.github/workflows/public-api-compatibility.yaml
@@ -0,0 +1,42 @@
+name: Public API compatibility
+
+on:
+  pull_request:
+    paths:
+      - 'interfaces/rime/text_to_speech.proto'
+      - '.github/workflows/public-api-compatibility.yaml'
+
+permissions:
+  contents: read
+
+jobs:
+  compatibility:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+      - uses: bazel-contrib/setup-bazel@0.19.0
+        with:
+          bazelisk-version: 1.x
+          repository-cache: true
+      - name: Check public Protobuf compatibility
+        env:
+          BASE_SHA: ${{ github.event.pull_request.base.sha }}
+        run: |
+          baseline=$(mktemp -d)
+          trap 'rm -rf "$baseline"' EXIT
+          mkdir -p "$baseline/previous/rime" "$baseline/current/rime"
+          git show "$BASE_SHA:interfaces/rime/text_to_speech.proto" > "$baseline/previous/rime/text_to_speech.proto"
+          cp interfaces/rime/text_to_speech.proto "$baseline/current/rime/"
+          for directory in previous current; do
+            cat > "$baseline/$directory/buf.yaml" <<'CONFIG'
+          version: v2
+          modules:
+            - path: .
+          breaking:
+            use: [FILE]
+          CONFIG
+          done
+          bazel run --config=host --config=buildkite @rules_buf_toolchains//:buf -- \
+            breaking "$baseline/current" --against "$baseline/previous"
